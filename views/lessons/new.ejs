<%- include('../partials/header') %>
<div class="row justify-content-center">
  <div class="col-lg-8">
    <nav aria-label="breadcrumb">
      <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="/courses">Courses</a></li>
        <li class="breadcrumb-item"><a href="/courses/<%= course.id %>"><%= course.title %></a></li>
        <li class="breadcrumb-item active" aria-current="page">New lesson</li>
      </ol>
    </nav>
    <div class="card shadow-sm">
      <div class="card-body p-4">
        <h1 class="h4 mb-1">New lesson</h1>
        <p class="text-muted small mb-4">The lesson is added at the end of the course. You can reorder it afterwards.</p>
        <form action="/courses/<%= course.id %>/lessons" method="post" novalidate>
          <input type="hidden" name="_csrf" value="<%= csrfToken() %>">
          <%- include('_form') %>
          <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary">Add lesson</button>
            <a href="/courses/<%= course.id %>" class="btn btn-outline-secondary">Cancel</a>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>
<%- include('../partials/footer') %>
