<div class="mb-3">
  <label for="title" class="form-label">Title</label>
  <input type="text" id="title" name="title" maxlength="120" required
         class="form-control <%= errors.title ? 'is-invalid' : '' %>" value="<%= values.title || '' %>">
  <% if (errors.title) { %><div class="invalid-feedback"><%= errors.title %></div><% } %>
</div>
<div class="mb-3">
  <label for="content" class="form-label">Content</label>
  <textarea id="content" name="content" rows="10" maxlength="10000" required
            class="form-control <%= errors.content ? 'is-invalid' : '' %>"><%= values.content || '' %></textarea>
  <% if (errors.content) { %>
    <div class="invalid-feedback"><%= errors.content %></div>
  <% } else { %>
    <div class="form-text">Plain text. Line breaks are kept.</div>
  <% } %>
</div>
