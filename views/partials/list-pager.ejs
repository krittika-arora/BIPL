<%# Expects: total, page, pages, pageSize, basePath, noun ('learner', 'completion'...). %>
<% const first = total ? (page - 1) * pageSize + 1 : 0; const last = Math.min(page * pageSize, total); %>
<% if (pages > 1) { %>
  <nav class="mt-3" aria-label="Pages">
    <ul class="pagination pagination-sm justify-content-center flex-wrap mb-1">
      <li class="page-item <%= page === 1 ? 'disabled' : '' %>">
        <a class="page-link" href="<%= basePath %>?page=<%= page - 1 %>">Previous</a>
      </li>
      <% for (let n = 1; n <= pages; n += 1) { %>
        <li class="page-item <%= n === page ? 'active' : '' %>">
          <a class="page-link" href="<%= basePath %>?page=<%= n %>" <%= n === page ? 'aria-current="page"' : '' %>><%= n %></a>
        </li>
      <% } %>
      <li class="page-item <%= page === pages ? 'disabled' : '' %>">
        <a class="page-link" href="<%= basePath %>?page=<%= page + 1 %>">Next</a>
      </li>
    </ul>
    <p class="text-center small text-muted mb-0">Showing <%= first %>–<%= last %> of <%= total %></p>
  </nav>
<% } %>
