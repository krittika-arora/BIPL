<nav class="navbar navbar-expand-lg navbar-dark bg-dark">
  <div class="container">
    <a class="navbar-brand fw-semibold" href="/">CourseTrack</a>
    <% if (locals.currentUser) { %>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
              aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse" id="mainNav">
        <ul class="navbar-nav me-auto">
          <li class="nav-item">
            <a class="nav-link <%= currentPath === '/' ? 'active' : '' %>" href="/">Home</a>
          </li>
          <li class="nav-item">
            <a class="nav-link <%= currentPath.startsWith('/courses') ? 'active' : '' %>" href="/courses">Courses</a>
          </li>
          <% if (currentUser.role === 'instructor') { %>
            <li class="nav-item">
              <a class="nav-link <%= currentPath.startsWith('/alerts') ? 'active' : '' %>" href="/alerts">
                Alerts
                <% if (locals.openAlertCount) { %>
                  <span class="badge rounded-pill text-bg-warning ms-1"><%= openAlertCount %></span>
                  <span class="visually-hidden">open inactivity alerts</span>
                <% } %>
              </a>
            </li>
          <% } %>
          <% if (currentUser.role === 'learner') { %>
            <li class="nav-item">
              <a class="nav-link <%= currentPath === '/my-learning' ? 'active' : '' %>" href="/my-learning">My learning</a>
            </li>
          <% } %>
        </ul>
        <div class="d-flex align-items-center gap-3">
          <a href="/account" class="navbar-text small text-decoration-none <%= currentPath.startsWith('/account') ? 'text-white' : '' %>"
             title="My account">
            <%= currentUser.name %>
            <span class="badge text-bg-secondary text-capitalize ms-1"><%= currentUser.role %></span>
          </a>
          <form action="/logout" method="post">
            <input type="hidden" name="_csrf" value="<%= csrfToken() %>">
            <button class="btn btn-outline-light btn-sm" type="submit">Log out</button>
          </form>
        </div>
      </div>
    <% } else { %>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#publicNav"
              aria-controls="publicNav" aria-expanded="false" aria-label="Toggle navigation">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse" id="publicNav">
        <ul class="navbar-nav me-auto">
          <li class="nav-item">
            <a class="nav-link <%= currentPath === '/' ? 'active' : '' %>" href="/">Home</a>
          </li>
          <li class="nav-item">
            <a class="nav-link <%= currentPath.startsWith('/courses') ? 'active' : '' %>" href="/courses">Courses</a>
          </li>
        </ul>
        <div class="d-flex gap-2">
          <a class="btn btn-outline-light btn-sm" href="/login">Log in</a>
          <a class="btn btn-light btn-sm" href="/register">Create account</a>
        </div>
      </div>
    <% } %>
  </div>
</nav>
