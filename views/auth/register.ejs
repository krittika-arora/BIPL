<%- include('../partials/header') %>
<div class="row justify-content-center">
  <div class="col-sm-10 col-md-6 col-lg-5">
    <div class="card shadow-sm">
      <div class="card-body p-4">
        <h1 class="h4 mb-1">Create account</h1>
        <p class="text-muted small mb-3">New accounts are learner accounts. Instructor access is set up by the training team.</p>
        <form action="/register" method="post" novalidate>
          <div class="mb-3">
            <label for="name" class="form-label">Full name</label>
            <input type="text" id="name" name="name" autocomplete="name" maxlength="80" required
                   class="form-control <%= errors.name ? 'is-invalid' : '' %>" value="<%= values.name || '' %>">
            <% if (errors.name) { %><div class="invalid-feedback"><%= errors.name %></div><% } %>
          </div>
          <div class="mb-3">
            <label for="email" class="form-label">Work email</label>
            <input type="email" id="email" name="email" autocomplete="email" required
                   class="form-control <%= errors.email ? 'is-invalid' : '' %>" value="<%= values.email || '' %>">
            <% if (errors.email) { %><div class="invalid-feedback"><%= errors.email %></div><% } %>
          </div>
          <div class="mb-3">
            <label for="password" class="form-label">Password</label>
            <input type="password" id="password" name="password" autocomplete="new-password" required
                   class="form-control <%= errors.password ? 'is-invalid' : '' %>" aria-describedby="passwordHelp">
            <% if (errors.password) { %>
              <div class="invalid-feedback"><%= errors.password %></div>
            <% } else { %>
              <div id="passwordHelp" class="form-text">At least 8 characters, with a letter and a number.</div>
            <% } %>
          </div>
          <div class="mb-3">
            <label for="confirmPassword" class="form-label">Confirm password</label>
            <input type="password" id="confirmPassword" name="confirmPassword" autocomplete="new-password" required
                   class="form-control <%= errors.confirmPassword ? 'is-invalid' : '' %>">
            <% if (errors.confirmPassword) { %><div class="invalid-feedback"><%= errors.confirmPassword %></div><% } %>
          </div>
          <button type="submit" class="btn btn-primary w-100">Create account</button>
        </form>
      </div>
    </div>
    <p class="text-center text-muted small mt-3">Already have an account? <a href="/login">Log in</a></p>
  </div>
</div>
<%- include('../partials/footer') %>
