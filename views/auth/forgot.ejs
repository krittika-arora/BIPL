<%- include('../partials/header') %>
<div class="row justify-content-center">
  <div class="col-sm-10 col-md-6 col-lg-4">
    <div class="card shadow-sm">
      <div class="card-body p-4">
        <h1 class="h4 mb-1">Forgot your password?</h1>
        <p class="text-muted small mb-3">Enter the email you log in with. We will send you a code to set a new password.</p>
        <% if (errors.form) { %>
          <div class="alert alert-danger py-2" role="alert"><%= errors.form %></div>
        <% } %>
        <form action="/forgot-password" method="post" novalidate>
          <div class="mb-3">
            <label for="email" class="form-label">Email</label>
            <input type="email" id="email" name="email" autocomplete="email" required autofocus
                   class="form-control <%= errors.email ? 'is-invalid' : '' %>" value="<%= values.email || '' %>">
            <% if (errors.email) { %><div class="invalid-feedback"><%= errors.email %></div><% } %>
          </div>
          <button type="submit" class="btn btn-primary w-100">Send code</button>
        </form>
      </div>
    </div>
    <p class="text-center text-muted small mt-3"><a href="/login">Back to log in</a></p>
  </div>
</div>
<%- include('../partials/footer') %>
