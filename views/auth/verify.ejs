<%- include('../partials/header') %>
<div class="row justify-content-center">
  <div class="col-sm-10 col-md-6 col-lg-4">
    <div class="card shadow-sm">
      <div class="card-body p-4">
        <h1 class="h4 mb-1">Check your email</h1>
        <p class="text-muted small mb-3">
          We sent a <%= codeLength %>-digit code to <strong><%= maskedEmail %></strong>.
          It expires <%= validMinutes %> minutes after it was sent.
        </p>

        <% if (devConsoleMail) { %>
          <div class="alert alert-secondary small py-2" role="note">
            Development mode: no SMTP server is configured, so the email (with the code) was printed in the server terminal.
          </div>
        <% } %>
        <% if (error) { %>
          <div class="alert alert-danger py-2" role="alert"><%= error %></div>
        <% } %>

        <form action="/register/verify" method="post" novalidate>
          <input type="hidden" name="_csrf" value="<%= csrfToken() %>">
          <div class="mb-3">
            <label for="code" class="form-label">Verification code</label>
            <input type="text" id="code" name="code" required autofocus
                   inputmode="numeric" autocomplete="one-time-code" pattern="[0-9]*" maxlength="<%= codeLength + 2 %>"
                   class="form-control form-control-lg text-center font-monospace <%= error ? 'is-invalid' : '' %>"
                   placeholder="<%= '0'.repeat(codeLength) %>" style="letter-spacing: .4em">
          </div>
          <button type="submit" class="btn btn-primary w-100">Verify and create account</button>
        </form>

        <hr>
        <div class="small text-muted">
          <p class="mb-2">Didn't get it? Check your spam folder, or request a new code.</p>
          <% if (signupStatus.sendsLeft > 0) { %>
            <form action="/register/resend" method="post" class="d-inline">
              <input type="hidden" name="_csrf" value="<%= csrfToken() %>">
              <button type="submit" class="btn btn-link btn-sm p-0 align-baseline">Send a new code</button>
            </form>
            <% if (signupStatus.resendInSeconds > 0) { %>
              <span>(available in <%= signupStatus.resendInSeconds %> seconds)</span>
            <% } %>
          <% } else { %>
            <span>No more codes can be sent right now. Please try again in an hour.</span>
          <% } %>
          <span class="mx-1">&middot;</span>
          <a href="/register">Use a different email</a>
        </div>
      </div>
    </div>
  </div>
</div>
<%- include('../partials/footer') %>
