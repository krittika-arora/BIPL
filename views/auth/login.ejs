<%- include('../partials/header') %>
<div class="row justify-content-center">
  <div class="col-sm-10 col-md-6 col-lg-4">
    <div class="card shadow-sm">
      <div class="card-body p-4">
        <h1 class="h4 mb-3">Log in</h1>
        <% if (errors.form) { %>
          <div class="alert alert-danger py-2" role="alert"><%= errors.form %></div>
        <% } %>
        <form action="/login" method="post" novalidate>
          <% if (values.next) { %><input type="hidden" name="next" value="<%= values.next %>"><% } %>
          <div class="mb-3">
            <label for="email" class="form-label">Email</label>
            <input type="email" id="email" name="email" autocomplete="email" required
                   class="form-control <%= errors.email ? 'is-invalid' : '' %>" value="<%= values.email || '' %>">
            <% if (errors.email) { %><div class="invalid-feedback"><%= errors.email %></div><% } %>
          </div>
          <div class="mb-3">
            <div class="d-flex justify-content-between align-items-baseline">
              <label for="password" class="form-label">Password</label>
              <a href="/forgot-password" class="small">Forgot password?</a>
            </div>
            <input type="password" id="password" name="password" autocomplete="current-password" required
                   class="form-control <%= errors.password ? 'is-invalid' : '' %>">
            <% if (errors.password) { %><div class="invalid-feedback"><%= errors.password %></div><% } %>
          </div>
          <button type="submit" class="btn btn-primary w-100">Log in</button>
        </form>
      </div>
    </div>
    <p class="text-center text-muted small mt-3">New here? <a href="/register<%= values.next ? `?next=${encodeURIComponent(values.next)}` : '' %>">Create a learner account</a></p>
  </div>
</div>
<%- include('../partials/footer') %>
