<%- include('../partials/header') %>
<% const STATES = [
     ['not_started', 'Not started', 'bg-secondary-subtle text-body'],
     ['in_progress', 'In progress', 'bg-primary'],
     ['completed', 'Completed', 'bg-success'],
   ];
   const pct = (part, whole) => (whole ? Math.round((part / whole) * 100) : 0); %>
<div class="d-flex justify-content-between align-items-center mb-3">
  <h1 class="h3 mb-0">Dashboard</h1>
  <a href="/courses" class="btn btn-outline-primary btn-sm">All courses</a>
</div>

<div class="row g-3 mb-4">
  <% [
       ['Total learners', headline.totalLearners, '/dashboard/learners'],
       ['Published courses', headline.publishedCourses, '/courses?status=published'],
       ['Completions this month', headline.completionsThisMonth, '/dashboard/completions'],
       ['Learners in progress', headline.learnersInProgress, '/dashboard/in-progress'],
     ].forEach(([label, value, href]) => { %>
    <div class="col-6 col-lg-3">
      <a href="<%= href %>" class="stat-tile d-block bg-white border rounded-3 p-3 h-100 text-decoration-none text-body"
         aria-label="<%= label %>: <%= value %>. Show the list">
        <div class="small text-muted d-flex justify-content-between">
          <span><%= label %></span><span class="stat-tile-arrow" aria-hidden="true">&rarr;</span>
        </div>
        <div class="display-6 fw-semibold"><%= value %></div>
        <div class="small text-primary">View list</div>
      </a>
    </div>
  <% }) %>
</div>

<section class="bg-white border rounded-3 p-4 mb-4">
  <div class="d-flex flex-wrap justify-content-between align-items-baseline gap-2 mb-3">
    <h2 class="h5 mb-0">Completions over the last eight weeks</h2>
    <span class="small text-muted">Weeks start on Monday (UTC)</span>
  </div>
  <div style="height: 260px">
    <canvas id="weekly-completions-chart" role="img"
            aria-label="Bar chart of course completions per week for the last eight weeks"></canvas>
  </div>
  <details class="mt-2 small">
    <summary class="text-muted">Show as table</summary>
    <table class="table table-sm mt-2 mb-0">
      <thead><tr><th scope="col">Week of</th><th scope="col" class="text-end">Completions</th></tr></thead>
      <tbody>
        <% weekly.forEach((week) => { %>
          <tr><td><%= week.label %></td><td class="text-end"><%= week.count %></td></tr>
        <% }) %>
      </tbody>
    </table>
  </details>
  <script type="application/json" id="weekly-completions-data"><%- jsonForScript(weekly) %></script>
</section>

<div class="row g-4">
  <div class="col-lg-4">
    <section class="bg-white border rounded-3 p-4 h-100">
      <h2 class="h5 mb-1">Enrolments by progress</h2>
      <p class="small text-muted mb-3"><%= totalEnrollments %> enrolments across all courses</p>
      <% if (totalEnrollments) { %>
        <div class="progress-stacked mb-3" style="height: 1.25rem" aria-hidden="true">
          <% STATES.forEach(([key, , bar]) => { %>
            <div class="progress" role="progressbar" style="width: <%= pct(statusCounts[key], totalEnrollments) %>%">
              <div class="progress-bar <%= bar %>"></div>
            </div>
          <% }) %>
        </div>
      <% } %>
      <table class="table table-sm mb-0">
        <tbody>
          <% STATES.forEach(([key, label, bar]) => { %>
            <tr>
              <td><span class="d-inline-block rounded-circle me-2 <%= bar %>" style="width:.7rem;height:.7rem"></span><%= label %></td>
              <td class="text-end fw-semibold"><%= statusCounts[key] %></td>
              <td class="text-end text-muted"><%= pct(statusCounts[key], totalEnrollments) %>%</td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </section>
  </div>

  <div class="col-lg-8">
    <section class="bg-white border rounded-3 p-4 h-100">
      <h2 class="h5 mb-3">Enrolments by course</h2>
      <% if (!byCourse.length) { %>
        <p class="text-muted mb-0">No enrolments yet.</p>
      <% } else { %>
        <div class="table-responsive">
          <table class="table table-sm align-middle mb-0">
            <thead class="table-light">
              <tr>
                <th scope="col">Course</th>
                <th scope="col" class="text-end">Not started</th>
                <th scope="col" class="text-end">In progress</th>
                <th scope="col" class="text-end">Completed</th>
                <th scope="col" class="text-end">Total</th>
                <th scope="col" style="min-width: 8rem">Completion</th>
              </tr>
            </thead>
            <tbody>
              <% byCourse.forEach((row) => { %>
                <tr>
                  <td>
                    <a href="/courses/<%= row._id %>" class="text-decoration-none"><%= row.course.title %></a>
                    <% if (row.course.status !== 'published') { %>
                      <span class="badge text-capitalize <%= statusBadge(row.course.status) %> ms-1"><%= row.course.status %></span>
                    <% } %>
                  </td>
                  <td class="text-end"><%= row.not_started %></td>
                  <td class="text-end"><%= row.in_progress %></td>
                  <td class="text-end"><%= row.completed %></td>
                  <td class="text-end fw-semibold"><%= row.total %></td>
                  <td>
                    <div class="progress" role="progressbar" aria-label="Completion for <%= row.course.title %>"
                         aria-valuenow="<%= pct(row.completed, row.total) %>" aria-valuemin="0" aria-valuemax="100">
                      <div class="progress-bar bg-success" style="width: <%= pct(row.completed, row.total) %>%"></div>
                    </div>
                    <div class="small text-muted"><%= pct(row.completed, row.total) %>%</div>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </section>
  </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
<script src="/js/dashboard.js"></script>
<%- include('../partials/footer') %>
