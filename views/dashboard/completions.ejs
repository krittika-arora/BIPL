<%- include('../partials/header') %>
<nav aria-label="breadcrumb">
  <ol class="breadcrumb">
    <li class="breadcrumb-item"><a href="/">Dashboard</a></li>
    <li class="breadcrumb-item active" aria-current="page">Completions this month</li>
  </ol>
</nav>
<div class="d-flex flex-wrap justify-content-between align-items-baseline gap-2 mb-3">
  <h1 class="h3 mb-0">Completions this month <span class="text-muted fw-normal">(<%= total %>)</span></h1>
  <span class="small text-muted">Since <%= formatDate(since) %> (UTC), newest first</span>
</div>

<% if (!rows.length) { %>
  <div class="bg-white border rounded-3 p-4 text-muted">No courses have been completed this month yet.</div>
<% } else { %>
  <div class="table-responsive bg-white border rounded-3">
    <table class="table table-hover mb-0">
      <thead class="table-light">
        <tr>
          <th scope="col">Learner</th>
          <th scope="col">Course</th>
          <th scope="col">Enrolled</th>
          <th scope="col">Completed</th>
        </tr>
      </thead>
      <tbody>
        <% rows.forEach((row) => { %>
          <tr>
            <td>
              <span class="fw-semibold"><%= row.learner ? row.learner.name : 'Deleted user' %></span>
              <div class="small text-muted"><%= row.learner ? row.learner.email : '' %></div>
            </td>
            <td>
              <% if (row.course) { %>
                <a href="/courses/<%= row.course._id %>" class="text-decoration-none"><%= row.course.title %></a>
                <% if (row.course.status !== 'published') { %>
                  <span class="badge text-capitalize <%= statusBadge(row.course.status) %> ms-1"><%= row.course.status %></span>
                <% } %>
              <% } else { %>—<% } %>
            </td>
            <td class="text-nowrap small"><%= formatDate(row.createdAt) %></td>
            <td class="text-nowrap small"><%= formatDateTime(row.completedAt) %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
  <%- include('../partials/list-pager') %>
<% } %>
<%- include('../partials/footer') %>
