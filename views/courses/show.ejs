<%- include('../partials/header') %>
<% const isVisitor = !locals.currentUser; %>
<% const isInstructor = !isVisitor && currentUser.role === 'instructor'; %>
<% const isOwner = isCourseOwner(locals.currentUser, course); %>
<nav aria-label="breadcrumb">
  <ol class="breadcrumb">
    <li class="breadcrumb-item"><a href="/courses">Courses</a></li>
    <li class="breadcrumb-item active" aria-current="page"><%= course.title %></li>
  </ol>
</nav>

<div class="bg-white border rounded-3 p-4 mb-4">
  <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-2">
    <div>
      <h1 class="h3 mb-1"><%= course.title %></h1>
      <div class="text-muted small">
        <%= course.category %> &middot; by <%= course.instructor ? course.instructor.name : 'Unknown' %>
        &middot; created <%= formatDate(course.createdAt) %>
      </div>
    </div>
    <div class="d-flex align-items-center gap-2">
      <% if (isInstructor) { %>
        <% const NEXT_ACTION = {
             draft: { to: 'published', label: 'Publish', style: 'btn-success' },
             published: { to: 'archived', label: 'Archive', style: 'btn-outline-dark',
                          confirm: 'Archive this course? It will be hidden from the catalogue. Lessons and enrolments are kept.' },
             archived: { to: 'published', label: 'Restore', style: 'btn-outline-success' },
           }[course.status]; %>
        <span class="badge text-capitalize <%= statusBadge(course.status) %>"><%= course.status %></span>
        <% if (isOwner) { %>
          <a href="/courses/<%= course._id %>/edit" class="btn btn-outline-primary btn-sm">Edit</a>
          <form action="/courses/<%= course._id %>/status" method="post"
                <% if (NEXT_ACTION.confirm) { %>onsubmit="return confirm('<%= NEXT_ACTION.confirm %>');"<% } %>>
            <input type="hidden" name="to" value="<%= NEXT_ACTION.to %>">
            <button type="submit" class="btn btn-sm <%= NEXT_ACTION.style %>"><%= NEXT_ACTION.label %></button>
          </form>
        <% } %>
      <% } %>
    </div>
  </div>
  <p class="text-pre-line mb-0"><%= course.description %></p>
  <% if (isInstructor && !isOwner) { %>
    <div class="alert alert-light border small mt-3 mb-0" role="note">
      This course belongs to <%= course.instructor ? course.instructor.name : 'another instructor' %>.
      You can view it, follow its learners' progress and export it; only they can change it or enrol learners.
    </div>
  <% } %>
</div>

<% if (!isInstructor) { %>
  <%- include('_enrollment', { enrollment }) %>
<% } %>

<%- include('_lessons', { isInstructor, isOwner }) %>

<% if (isInstructor) { %>
  <%- include('_roster', { roster, isOwner }) %>
<% } %>

<% const canComment = isInstructor || Boolean(enrollment); %>
<% if (!isVisitor) { %>
<section class="bg-white border rounded-3 p-4" id="discussion">
  <h2 class="h5 mb-1"><%= isInstructor ? 'Activity log' : 'Discussion' %></h2>
  <p class="text-muted small mb-3">
    <%= isInstructor
      ? 'Every change and comment, oldest first. Entries are permanent and cannot be edited or deleted.'
      : 'Questions and comments from learners and instructors. Comments are permanent once posted.' %>
  </p>
  <%- include('_activity', { activity }) %>

  <% if (canComment) { %>
    <form action="/courses/<%= course._id %>/comments" method="post" class="mt-3">
      <label for="message" class="form-label small fw-semibold">Add a comment</label>
      <textarea id="message" name="message" rows="3" maxlength="1000" required class="form-control mb-2"
                placeholder="<%= isInstructor ? 'Note for the record, or a reply to learners' : 'Ask a question or share a tip' %>"></textarea>
      <button type="submit" class="btn btn-outline-primary btn-sm">Post comment</button>
    </form>
  <% } else { %>
    <p class="small text-muted mt-3 mb-0">Enrol in this course to join the discussion.</p>
  <% } %>
</section>
<% } %>
<%- include('../partials/footer') %>
