<% const canEditLessons = isInstructor && course.status !== 'archived'; %>
<% const canOpenLessons = isInstructor || Boolean(locals.enrollment); %>
<section class="bg-white border rounded-3 p-4 mb-4">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="h5 mb-0">Lessons <span class="text-muted fw-normal">(<%= lessons.length %>)</span></h2>
    <% if (canEditLessons) { %>
      <a href="/courses/<%= course._id %>/lessons/new" class="btn btn-primary btn-sm">Add lesson</a>
    <% } %>
  </div>

  <% if (!lessons.length) { %>
    <p class="text-muted mb-0">
      No lessons yet.<% if (isInstructor) { %> A course needs at least one lesson before it can be published.<% } %>
    </p>
  <% } else { %>
    <ol class="list-group">
      <% lessons.forEach((lesson, index) => { %>
        <li class="list-group-item d-flex flex-wrap justify-content-between align-items-center gap-2">
          <div>
            <span class="text-muted me-2"><%= lesson.position %>.</span>
            <% if (canOpenLessons) { %>
              <a href="/courses/<%= course._id %>/lessons/<%= lesson._id %>" class="text-decoration-none"><%= lesson.title %></a>
            <% } else { %>
              <%= lesson.title %>
            <% } %>
          </div>
          <% if (canEditLessons) { %>
            <div class="d-flex gap-1">
              <form action="/courses/<%= course._id %>/lessons/<%= lesson._id %>/move" method="post">
                <input type="hidden" name="direction" value="up">
                <button type="submit" class="btn btn-outline-secondary btn-sm" aria-label="Move up"
                        <%= index === 0 ? 'disabled' : '' %>>&uarr;</button>
              </form>
              <form action="/courses/<%= course._id %>/lessons/<%= lesson._id %>/move" method="post">
                <input type="hidden" name="direction" value="down">
                <button type="submit" class="btn btn-outline-secondary btn-sm" aria-label="Move down"
                        <%= index === lessons.length - 1 ? 'disabled' : '' %>>&darr;</button>
              </form>
              <a href="/courses/<%= course._id %>/lessons/<%= lesson._id %>/edit" class="btn btn-outline-secondary btn-sm">Edit</a>
              <form action="/courses/<%= course._id %>/lessons/<%= lesson._id %>/delete" method="post"
                    onsubmit="return confirm('Remove this lesson? Learners will no longer see it.');">
                <button type="submit" class="btn btn-outline-danger btn-sm">Remove</button>
              </form>
            </div>
          <% } %>
        </li>
      <% }) %>
    </ol>
  <% } %>
</section>
