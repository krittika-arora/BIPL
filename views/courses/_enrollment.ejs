<section class="bg-white border rounded-3 p-4 mb-4">
  <% if (!locals.currentUser) { %>
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
      <div>
        <h2 class="h5 mb-1">Want to take this course?</h2>
        <p class="text-muted mb-0">Log in or create a free learner account to enrol and track your progress.</p>
      </div>
      <div class="d-flex gap-2">
        <a href="/login" class="btn btn-primary">Log in to enrol</a>
        <a href="/register" class="btn btn-outline-primary">Create account</a>
      </div>
    </div>
  <% } else if (!enrollment) { %>
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
      <div>
        <h2 class="h5 mb-1">Ready to start?</h2>
        <p class="text-muted mb-0">Enrol to open the lessons. Your progress is saved as you go.</p>
      </div>
      <form action="/courses/<%= course._id %>/enroll" method="post">
        <button type="submit" class="btn btn-primary">Enrol in this course</button>
      </form>
    </div>
  <% } else { %>
    <% const lessonIds = lessons.map((lesson) => lesson._id); %>
    <% const percent = progressPercent(enrollment, lessonIds); %>
    <% const firstOpen = lessons.find((lesson) => !isLessonCompleted(enrollment, lesson._id)); %>
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
      <div>
        <h2 class="h5 mb-1">Your progress</h2>
        <p class="text-muted small mb-0">
          <%= countCompleted(enrollment, lessonIds) %> of <%= lessons.length %> lessons completed
          &middot; enrolled <%= formatDate(enrollment.createdAt) %>
          <% if (enrollment.completedAt) { %>&middot; completed <%= formatDate(enrollment.completedAt) %><% } %>
        </p>
      </div>
      <div class="d-flex align-items-center gap-2">
        <span class="badge <%= progressBadge(enrollment.status) %>"><%= progressLabel(enrollment.status) %></span>
        <% if (firstOpen && enrollment.status !== 'completed') { %>
          <a href="/courses/<%= course._id %>/lessons/<%= firstOpen._id %>" class="btn btn-primary btn-sm">
            <%= enrollment.status === 'not_started' ? 'Start course' : 'Continue' %>
          </a>
        <% } %>
      </div>
    </div>
    <div class="progress" role="progressbar" aria-label="Course progress"
         aria-valuenow="<%= percent %>" aria-valuemin="0" aria-valuemax="100">
      <div class="progress-bar <%= percent === 100 ? 'bg-success' : '' %>" style="width: <%= percent %>%"><%= percent %>%</div>
    </div>
  <% } %>
</section>
