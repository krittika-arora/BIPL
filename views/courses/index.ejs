<%- include('../partials/header') %>
<% const isInstructor = currentUser.role === 'instructor'; %>
<div class="d-flex justify-content-between align-items-center mb-3">
  <h1 class="h3 mb-0">Courses</h1>
  <% if (isInstructor) { %>
    <a href="/courses/new" class="btn btn-primary">New course</a>
  <% } %>
</div>

<form action="/courses" method="get" class="bg-white border rounded-3 p-3 mb-3" role="search">
  <div class="row g-2 align-items-end">
    <div class="col-12 col-lg">
      <label for="q" class="form-label small text-muted mb-1">Search</label>
      <input type="search" id="q" name="q" value="<%= params.q %>" maxlength="100"
             class="form-control" placeholder="Title or description">
    </div>
    <div class="col-6 col-md-3 col-lg-2">
      <label for="category" class="form-label small text-muted mb-1">Category</label>
      <select id="category" name="category" class="form-select">
        <option value="">All categories</option>
        <% categories.forEach((category) => { %>
          <option value="<%= category %>" <%= params.category === category ? 'selected' : '' %>><%= category %></option>
        <% }) %>
      </select>
    </div>
    <% if (isInstructor) { %>
      <div class="col-6 col-md-3 col-lg-2">
        <label for="status" class="form-label small text-muted mb-1">Status</label>
        <select id="status" name="status" class="form-select">
          <option value="">All statuses</option>
          <% statuses.forEach((status) => { %>
            <option value="<%= status %>" class="text-capitalize" <%= params.status === status ? 'selected' : '' %>><%= status %></option>
          <% }) %>
        </select>
      </div>
    <% } %>
    <div class="col-6 col-md-3 col-lg-2">
      <label for="instructor" class="form-label small text-muted mb-1">Instructor</label>
      <select id="instructor" name="instructor" class="form-select">
        <option value="">All instructors</option>
        <% instructors.forEach((person) => { %>
          <option value="<%= person._id %>" <%= params.instructor === String(person._id) ? 'selected' : '' %>><%= person.name %></option>
        <% }) %>
      </select>
    </div>
    <div class="col-6 col-md-3 col-lg-auto d-flex gap-2">
      <button type="submit" class="btn btn-primary">Apply</button>
      <% if (filtered) { %><a href="/courses" class="btn btn-outline-secondary">Clear</a><% } %>
    </div>
  </div>
</form>

<% if (!courses.length) { %>
  <div class="bg-white border rounded-3 p-4 text-center text-muted">
    <% if (filtered) { %>
      No courses match these filters. <a href="/courses">Clear filters</a>
    <% } else if (isInstructor) { %>
      No courses yet. <a href="/courses/new">Create the first one</a>.
    <% } else { %>
      No courses have been published yet. Check back soon.
    <% } %>
  </div>
<% } else { %>
  <div class="table-responsive bg-white border rounded-3">
    <table class="table table-hover mb-0">
      <thead class="table-light">
        <tr>
          <th scope="col">Title</th>
          <th scope="col">Category</th>
          <% if (isInstructor) { %><th scope="col">Status</th><% } %>
          <th scope="col">Instructor</th>
          <th scope="col">Created</th>
        </tr>
      </thead>
      <tbody>
        <% courses.forEach((course) => { %>
          <tr>
            <td>
              <a href="/courses/<%= course._id %>" class="fw-semibold text-decoration-none"><%= course.title %></a>
              <div class="small text-muted"><%= truncate(course.description, 110) %></div>
            </td>
            <td><%= course.category %></td>
            <% if (isInstructor) { %>
              <td><span class="badge text-capitalize <%= statusBadge(course.status) %>"><%= course.status %></span></td>
            <% } %>
            <td><%= course.instructor ? course.instructor.name : '—' %></td>
            <td class="text-nowrap"><%= formatDate(course.createdAt) %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
<% } %>
<%- include('../partials/footer') %>
