# Copy this file to .env and fill in real values. Never commit .env.
PORT=3000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/coursetrack
# Used only by `npm test`. The tests DELETE this database, so its name must contain "test".
MONGODB_URI_TEST=mongodb://127.0.0.1:27017/coursetrack_test
# Long random string, e.g. output of: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-me

# --- Outgoing email (sign-up and password-reset codes) ---
# Option A: Brevo HTTPS API. Use this on hosts that block SMTP ports (e.g. Render free plan).
# Takes priority over SMTP when set. MAIL_FROM must be a sender verified in Brevo.
BREVO_API_KEY=
# Option B: SMTP (below).
# Leave SMTP_HOST empty in development to print emails to the console instead.
# Production will not start without it. See docs/email-setup.md for provider-specific values.
SMTP_HOST=
# 587 with SMTP_SECURE=false (STARTTLS), or 465 with SMTP_SECURE=true (TLS)
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
# For Gmail this must be a 16-character App Password, not your normal password.
SMTP_PASS=
# Sender shown to users, e.g. CourseTrack <you@gmail.com>. Defaults to SMTP_USER.
MAIL_FROM=
